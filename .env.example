# Copy to .env and fill in. Loaded automatically by "npm start" and docker compose.
# Variables set in the shell override these. Names are defined in config/config.json.
CLEANAPIS_API_KEY=cc_your_key_here
OPENROUTER_API_KEY=sk-or-your_key_here

# Either a plain PIN (hashed at startup) ...
WCA_PIN=
# ... or a pre-computed hash from "npm run set-pin" (takes precedence).
WCA_PIN_HASH=

# Optional: fixed session secret (otherwise generated and stored in the secrets file).
WCA_SESSION_SECRET=

# Optional: port and bind address (override server.port / server.host in config.json).
# Not used by docker compose, where the container always listens on 3000.
# PORT=3000
# HOST=0.0.0.0

# Docker Compose only (read by compose itself, not by the app):
# WCA_BIND=127.0.0.1        # 0.0.0.0 publishes the port on all interfaces
# WCA_PORT=3000             # port on the host
# NODE_IMAGE=node:22-alpine # base image, e.g. mirror.gcr.io/library/node:22-alpine
