{
  "name": "webchatapi",
  "version": "1.0.0",
  "description": "Self-hosted ChatGPT-like web interface for OpenAI-compatible API providers (CleanAPIs, OpenRouter, ...) with PIN authentication.",
  "main": "server/index.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "set-pin": "node server/cli/set-pin.js",
    "check": "node --check server/index.js && node server/cli/selftest.js"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.16",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "^6.3.289"
  },
  "license": "MIT"
}
